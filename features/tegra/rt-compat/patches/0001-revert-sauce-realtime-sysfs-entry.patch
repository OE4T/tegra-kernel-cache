From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Kurt Kiefer <kkiefer@nvidia.com>
Subject: [PATCH] Revert "NVIDIA: SAUCE: sysfs: Add /sys/kernel/realtime entry"

The preempt-rt kernel branch already carries this change upstream.
Applying the SAUCE version on top produces a duplicate-symbol build
error.  Remove the SAUCE copy; the upstream preempt-rt version remains.

diff --git a/kernel/ksysfs.c b/kernel/ksysfs.c
--- a/kernel/ksysfs.c
+++ b/kernel/ksysfs.c
@@ -188,15 +188,6 @@ KERNEL_ATTR_RO(crash_elfcorehdr_size);

 #endif /* CONFIG_VMCORE_INFO */

-#if defined(CONFIG_PREEMPT_RT)
-static ssize_t realtime_show(struct kobject *kobj,
-			     struct kobj_attribute *attr, char *buf)
-{
-	return sprintf(buf, "%d\n", 1);
-}
-KERNEL_ATTR_RO(realtime);
-#endif
-
 /* whether file capabilities are enabled */
 static ssize_t fscaps_show(struct kobject *kobj,
 				  struct kobj_attribute *attr, char *buf)
@@ -280,9 +271,6 @@ static struct attribute * kernel_attrs[] = {
 #ifndef CONFIG_TINY_RCU
 	&rcu_expedited_attr.attr,
 	&rcu_normal_attr.attr,
-#endif
-#ifdef CONFIG_PREEMPT_RT
-	&realtime_attr.attr,
 #endif
 	NULL
 };
