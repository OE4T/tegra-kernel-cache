From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Jon Hunter <jonathanh@nvidia.com>
Date: Tue, 17 Feb 2026 15:46:55 +0000
Subject: [PATCH 183/241] NVIDIA: SAUCE: soc/tegra: pmc: Multi-socket support

Add support for multi-socket devices.

Change-Id: I526e177cebc590549af160502c6a8903f352a743
Signed-off-by: Jon Hunter <jonathanh@nvidia.com>

diff --git a/drivers/soc/tegra/pmc.c b/drivers/soc/tegra/pmc.c
index 044fb34dc5ea..589f91b24b44 100644
--- a/drivers/soc/tegra/pmc.c
+++ b/drivers/soc/tegra/pmc.c
@@ -3163,6 +3163,78 @@ static void tegra_pmc_reset_suspend_mode(void *data)
 	pmc->suspend_mode = TEGRA_SUSPEND_NOT_READY;
 }
 
+/*
+ * Handle a secondary PMC instance (e.g. the second PMC on Tegra264). The
+ * primary singleton path in tegra_pmc_probe() cannot be reused because it
+ * always operates on the global pmc pointer.  Allocate a fresh per-device
+ * struct and perform the subset of initialisation that is relevant for a
+ * non-primary PMC (wake handling, IO-pad pinctrl, IRQ domain, reboot
+ * reason scratch registers).
+ */
+static int tegra_pmc_secondary_probe(struct platform_device *pdev)
+{
+	struct tegra_pmc *pmc2;
+	struct resource *res;
+	int err;
+
+	pmc2 = devm_kzalloc(&pdev->dev, sizeof(*pmc2), GFP_KERNEL);
+	if (!pmc2)
+		return -ENOMEM;
+
+	pmc2->soc = of_device_get_match_data(&pdev->dev);
+	pmc2->dev = &pdev->dev;
+	mutex_init(&pmc2->powergates_lock);
+
+	pmc2->base = devm_platform_ioremap_resource(pdev, 0);
+	if (IS_ERR(pmc2->base))
+		return PTR_ERR(pmc2->base);
+
+	pmc2->wake = devm_platform_ioremap_resource_byname(pdev, "wake");
+	if (IS_ERR(pmc2->wake))
+		return PTR_ERR(pmc2->wake);
+
+	res = platform_get_resource_byname(pdev, IORESOURCE_MEM, "scratch");
+	if (res) {
+		pmc2->scratch = devm_ioremap_resource(&pdev->dev, res);
+		if (IS_ERR(pmc2->scratch))
+			return PTR_ERR(pmc2->scratch);
+	}
+
+	if (pmc2->scratch) {
+		pmc2->reboot_notifier.notifier_call = tegra_pmc_reboot_notify;
+		err = devm_register_reboot_notifier(&pdev->dev,
+						    &pmc2->reboot_notifier);
+		if (err) {
+			dev_err(&pdev->dev,
+				"unable to register reboot notifier, %d\n",
+				err);
+			return err;
+		}
+	}
+
+	err = tegra_pmc_init(pmc2);
+	if (err < 0) {
+		dev_err(&pdev->dev, "failed to initialize PMC: %d\n", err);
+		return err;
+	}
+
+	err = tegra_pmc_pinctrl_init(pmc2);
+	if (err)
+		return err;
+
+	err = tegra_pmc_irq_init(pmc2);
+	if (err < 0)
+		return err;
+
+	if (pmc2->soc->set_wake_filters)
+		pmc2->soc->set_wake_filters(pmc2);
+
+	platform_set_drvdata(pdev, pmc2);
+	tegra_pmc_scratch_sysfs_init(pmc2);
+
+	return 0;
+}
+
 static int tegra_pmc_probe(struct platform_device *pdev)
 {
 	struct tegra_pmc *pmc;
@@ -3187,6 +3259,10 @@ static int tegra_pmc_probe(struct platform_device *pdev)
 	mutex_init(&pmc->powergates_lock);
 	pmc->dev = &pdev->dev;
 
+	/* Singleton already claimed by an earlier probe; use secondary path */
+	if (pmc->dev)
+		return tegra_pmc_secondary_probe(pdev);
+
 	err = tegra_pmc_parse_dt(pmc, pdev->dev.of_node);
 	if (err < 0)
 		return dev_err_probe(&pdev->dev, err, "failed to parse DT\n");
-- 
