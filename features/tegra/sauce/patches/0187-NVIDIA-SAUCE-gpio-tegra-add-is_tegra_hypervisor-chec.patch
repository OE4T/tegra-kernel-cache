Reviewed-on: https://git-master.nvidia.com/r/c/3rdparty/canonical/linux-noble/+/3446979
Tested-by: mobile promotions <svcmobile_promotions@nvidia.com>
GVS: buildbot_gerritrpt <buildbot_gerritrpt@nvidia.com>
Reviewed-by: mobile promotions <svcmobile_promotions@nvidia.com>
Reviewed-by: Bibek Basu <bbasu@nvidia.com>
(cherry picked from commit 1d3fdf3fc619b9ce12f3dac7b8afc3e3b49f385d)

diff --git a/drivers/gpio/gpio-tegra186.c b/drivers/gpio/gpio-tegra186.c
index 8309f9ae4a68b..74fbdccd82da2 100644
--- a/drivers/gpio/gpio-tegra186.c
+++ b/drivers/gpio/gpio-tegra186.c
@@ -16,6 +16,11 @@
 #include <linux/property.h>
 #include <linux/seq_file.h>
 #include <asm/delay.h>
+#include <linux/delay.h>
+
+#if IS_ENABLED(CONFIG_TEGRA_HV_DRIVER)
+#include <soc/tegra/virt/hv-ivc.h>
+#endif
 
 #include <dt-bindings/gpio/tegra186-gpio.h>
 #include <dt-bindings/gpio/tegra194-gpio.h>
@@ -466,6 +471,11 @@ static int tegra186_gpio_add_pin_ranges(struct gpio_chip *chip)
 	unsigned int i, j;
 	int err;
 
+#if IS_ENABLED(CONFIG_TEGRA_HV_DRIVER)
+	if (is_tegra_hypervisor_mode())
+		return 0;
+#endif
+
 	if (!gpio->soc->pinmux || gpio->soc->num_pin_ranges == 0)
 		return 0;
 
