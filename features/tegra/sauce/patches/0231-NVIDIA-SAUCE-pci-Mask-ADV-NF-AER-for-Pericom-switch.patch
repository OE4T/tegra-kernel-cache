From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Prakhar Srivastava <prasrivastav@nvidia.com>
Date: Wed, 28 Jan 2026 10:53:24 +0000
Subject: [PATCH 231/243] NVIDIA: SAUCE: pci: Mask ADV NF AER for Pericom
 switch

This commit introduces a quirk to mask spurious Advisory Non-Fatal
correctable errors generated by the Pericom PI7C9X2G608GP PCIe
switch during device enumeration. Mask these errors at the switch
only so they do not propagate to the root port.

Bug 5772682

Change-Id: I62f3f9c0687f539350eec724a92505f414b0fa28
Signed-off-by: Prakhar Srivastava <prasrivastav@nvidia.com>
Reviewed-on: https://git-master.nvidia.com/r/c/3rdparty/canonical/linux-noble/+/3537058
Reviewed-by: Paritosh Dixit <paritoshd@nvidia.com>
GVS: buildbot_gerritrpt <buildbot_gerritrpt@nvidia.com>
Reviewed-by: Brad Griffis <bgriffis@nvidia.com>
(cherry picked from commit dd3ce51ee801d8cb3ff8f397ab07cc248332fc6c)

diff --git a/drivers/pci/quirks.c b/drivers/pci/quirks.c
index fbfeb451e50a..0be4a1624857 100644
--- a/drivers/pci/quirks.c
+++ b/drivers/pci/quirks.c
@@ -6420,3 +6420,36 @@ static void quirk_realtek_mask_aer_rcv_err(struct pci_dev *dev)
 }
 DECLARE_PCI_FIXUP_FINAL(PCI_VENDOR_ID_REALTEK, PCI_DEVICE_ID_REALTEK_RTL8126,
 			quirk_realtek_mask_aer_rcv_err);
+
+/*
+ * Pericom PI7C9X2G608GP PCIe switch with bus holes (unpopulated downstream
+ * ports) generates spurious Advisory Non-Fatal correctable errors during
+ * device enumeration (e.g., lspci). Mask these errors at the switch only so
+ * they do not propagate to the root port.
+ *
+ * Advisory Non-Fatal Error (bit 13) indicates a correctable error that was
+ * originally classified as uncorrectable but has been masked to be advisory.
+ * This commonly occurs with bus holes where config reads to non-existent
+ * devices return all-1s.
+ */
+static void quirk_pericom_mask_aer_adv_nonfatal(struct pci_dev *pdev)
+{
+	int aer_pos;
+	u32 val;
+
+	aer_pos = pci_find_ext_capability(pdev, PCI_EXT_CAP_ID_ERR);
+	if (!aer_pos)
+		return;
+
+	pci_read_config_dword(pdev, aer_pos + PCI_ERR_COR_MASK, &val);
+	if (!(val & PCI_ERR_COR_ADV_NFAT)) {
+		val |= PCI_ERR_COR_ADV_NFAT;
+		pci_write_config_dword(pdev, aer_pos + PCI_ERR_COR_MASK, val);
+		pci_info(pdev, "Masked Advisory Non-Fatal AER errors\n");
+	}
+}
+/* PI7C9X2G608GP 6-Port/8-Lane Packet Switch */
+DECLARE_PCI_FIXUP_FINAL(PCI_VENDOR_ID_PERICOM, 0x2608,
+			quirk_pericom_mask_aer_adv_nonfatal);
+DECLARE_PCI_FIXUP_RESUME(PCI_VENDOR_ID_PERICOM, 0x2608,
+			 quirk_pericom_mask_aer_adv_nonfatal);
