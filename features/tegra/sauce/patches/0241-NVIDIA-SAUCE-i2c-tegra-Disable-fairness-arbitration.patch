 };
 
 static const struct tegra_i2c_hw_feature tegra256_i2c_hw = {
@@ -1894,6 +1908,7 @@ static const struct tegra_i2c_hw_feature tegra264_i2c_hw = {
 	.has_interface_timing_reg = true,
 	.enable_hs_mode_support = true,
