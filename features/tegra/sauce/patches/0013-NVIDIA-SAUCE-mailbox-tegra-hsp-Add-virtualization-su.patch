From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Kartik <kkartik@nvidia.com>
Date: Tue, 6 Feb 2024 09:36:34 +0000
Subject: [PATCH 013/243] NVIDIA: SAUCE: mailbox: tegra-hsp: Add virtualization
 support for Tegra264

Add virtualization support for Tegra264.

Change-Id: I8e5de37cf0f1e73aa1ea00e42f6c90ddc304e586
Signed-off-by: Kartik <kkartik@nvidia.com>

diff --git a/drivers/mailbox/tegra-hsp.c b/drivers/mailbox/tegra-hsp.c
index f89ed6d0646d..4abcf77ae22b 100644
--- a/drivers/mailbox/tegra-hsp.c
+++ b/drivers/mailbox/tegra-hsp.c
@@ -1149,12 +1149,31 @@ static const struct tegra_hsp_soc tegra234_hv_hsp_soc = {
 	.virtualized = true,
 };
 
+static const struct tegra_hsp_soc tegra264_hv_hsp_soc = {
+	.map = tegra186_hsp_db_map,
+	.has_per_mb_ie = true,
+	.has_128_bit_mb = true,
+	.reg_stride = 0x1000,
+	.si_shift = 17,
+	.db_shift = 12,
+	.as_shift = 8,
+	.ss_shift = 4,
+	.sm_shift = 0,
+	.si_mask = 0x1f,
+	.db_mask = 0x1f,
+	.as_mask = 0xf,
+	.ss_mask = 0xf,
+	.sm_mask = 0xf,
+	.virtualized = true,
+};
+
 static const struct of_device_id tegra_hsp_match[] = {
 	{ .compatible = "nvidia,tegra186-hsp", .data = &tegra186_hsp_soc },
 	{ .compatible = "nvidia,tegra194-hsp", .data = &tegra194_hsp_soc },
 	{ .compatible = "nvidia,tegra234-hsp", .data = &tegra234_hsp_soc },
 	{ .compatible = "nvidia,tegra264-hsp", .data = &tegra264_hsp_soc },
 	{ .compatible = "nvidia,tegra234-hsp-hv", .data = &tegra234_hv_hsp_soc },
+	{ .compatible = "nvidia,tegra264-hsp-hv", .data = &tegra264_hv_hsp_soc },
 	{ }
 };
 
