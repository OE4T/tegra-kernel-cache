diff --git a/drivers/pci/msi/msi.c b/drivers/pci/msi/msi.c
index e010ecd9f90dd..2124ce0ffd08c 100644
--- a/drivers/pci/msi/msi.c
+++ b/drivers/pci/msi/msi.c
@@ -117,7 +117,8 @@ void pci_msi_update_mask(struct msi_desc *desc, u32 clear, u32 set)
 	raw_spinlock_t *lock = &dev->msi_lock;
 	unsigned long flags;
 
-	if (!desc->pci.msi_attrib.can_mask)
+	if (!desc->pci.msi_attrib.can_mask ||
+	    unlikely(pci_dev_is_disconnected(msi_desc_to_pci_dev(desc))))
 		return;
 
 	raw_spin_lock_irqsave(lock, flags);
@@ -508,7 +509,7 @@ void __pci_restore_msi_state(struct pci_dev *dev)
 	struct msi_desc *entry;
 	u16 control;
 
-	if (!dev->msi_enabled)
+	if (!dev->msi_enabled || unlikely(pci_dev_is_disconnected(dev)))
 		return;
 
 	entry = irq_get_msi_desc(dev->irq);
@@ -863,7 +864,7 @@ void __pci_restore_msix_state(struct pci_dev *dev)
 	struct msi_desc *entry;
 	bool write_msg;
 
-	if (!dev->msix_enabled)
+	if (!dev->msix_enabled || unlikely(pci_dev_is_disconnected(dev)))
 		return;
 
 	/* route the table */
diff --git a/drivers/pci/msi/msi.h b/drivers/pci/msi/msi.h
index 0b420b319f50f..cbbbf38225bf4 100644
--- a/drivers/pci/msi/msi.h
+++ b/drivers/pci/msi/msi.h
@@ -42,6 +42,8 @@ static inline void pci_msix_write_vector_ctrl(struct msi_desc *desc, u32 ctrl)
 
 static inline void pci_msix_mask(struct msi_desc *desc)
 {
+	if (unlikely(pci_dev_is_disconnected(to_pci_dev(desc->dev))))
+		return;
 	desc->pci.msix_ctrl |= PCI_MSIX_ENTRY_CTRL_MASKBIT;
 	pci_msix_write_vector_ctrl(desc, desc->pci.msix_ctrl);
 	/* Flush write to device */
@@ -50,6 +52,8 @@ static inline void pci_msix_mask(struct msi_desc *desc)
 
 static inline void pci_msix_unmask(struct msi_desc *desc)
 {
+	if (unlikely(pci_dev_is_disconnected(to_pci_dev(desc->dev))))
+		return;
 	desc->pci.msix_ctrl &= ~PCI_MSIX_ENTRY_CTRL_MASKBIT;
 	pci_msix_write_vector_ctrl(desc, desc->pci.msix_ctrl);
 }
