 	.led_polarity_set = aqr_phy_led_polarity_set,
 	.inband_caps	= aqr_gen2_inband_caps,
 	.config_inband	= aqr_gen2_config_inband,
+	.get_wol	= &aqr113c_get_wol,
+	.set_wol	= &aqr113c_set_wol,
 },
 {
 	PHY_ID_MATCH_MODEL(PHY_ID_AQR405),
