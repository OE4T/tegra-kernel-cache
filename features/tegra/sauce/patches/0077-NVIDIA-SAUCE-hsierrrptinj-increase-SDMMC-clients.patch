 /**
  * @file tegra-hsierrrptinj.c
@@ -70,13 +70,13 @@ struct hsm_error_report_frame {
  * PSC   - 1
  * I2C   = 10
  * QSPI  - 2
- * SDMMC - 5
+ * SDMMC - 9
