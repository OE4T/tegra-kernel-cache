+
 struct tegra_xusb_padctl *tegra_xusb_padctl_get(struct device *dev);
 void tegra_xusb_padctl_put(struct tegra_xusb_padctl *padctl);
-
+int tegra_xusb_padctl_event_register(struct tegra_xusb_padctl *padctl,
