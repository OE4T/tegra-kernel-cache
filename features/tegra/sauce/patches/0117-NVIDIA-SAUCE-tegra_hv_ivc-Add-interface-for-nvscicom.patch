+uint32_t tegra_hv_get_max_qid(const struct ivc_info_page *info)
+{
+	uint32_t max_qid = 0;
+	uint32_t i;
+
+	for (i = 0; i < info->nr_queues; i++) {
+		const struct tegra_hv_queue_data *qd =
+				&ivc_info_queue_array(info)[i];
+
+		if (qd->id > max_qid)
+			max_qid = qd->id;
+	}
+
+	return max_qid;
+}
+EXPORT_SYMBOL(tegra_hv_get_max_qid);
