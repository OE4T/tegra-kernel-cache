 	{								\
 		.regbase	= xregbase,				\
-		.regcount	= 1,					\
+		.regcount	= 2,					\
 		.nbits		= 32,					\
 		.invert		= 0,					\
 		.min		= 0,					\
@@ -710,79 +691,24 @@ ASRC_SOURCE_DECL(src_select6, 5);
 }
 
